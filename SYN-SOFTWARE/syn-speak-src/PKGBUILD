# Maintainer: William Hayward-Holland (Syntax990)
pkgname=syn-speak
pkgver=1.0.0
pkgrel=1
pkgdesc="SYN-OS's Piper voice: speaks a line in a voice from ~/.local/share/syn-speak/voices through sherpa-onnx (the bar's read-aloud button, SYN-CASTER's crew). Ships no voices."
arch=('x86_64')
url="https://github.com/Syntax990/SYN-OS"
license=('MIT')
depends=('glibc')
makedepends=('cmake')
source=()
sha256sums=()

_projdir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

build() {
  cmake -B "$srcdir/build" -S "$_projdir" \
    -DCMAKE_BUILD_TYPE=Release
  cmake --build "$srcdir/build"
}

package() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/build" --prefix /usr
}
