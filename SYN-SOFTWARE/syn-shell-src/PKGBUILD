# Maintainer: William Hayward-Holland (Syntax990)
pkgname=syn-shell
pkgver=2.11.0
pkgrel=23
pkgdesc="SYN-SHELL: SYN-OS's own window onto the system. Ranger's three columns and keys, archives browsed like folders (libarchive), a shell area that moves to foot (libvterm), and where the disk space has gone: a turning 3D render in the corner that a click makes fill the window (2D / 3D / walkable), and a folder tree with sizes (zt), was SYN-DIRSTAT"
arch=('x86_64')
url="https://github.com/syn990/SYN-SHELL"
license=('MIT')
depends=('qt6-base' 'libarchive' 'libvterm' 'syntax-highlighting' 'sdl2' 'sdl2_ttf' 'libglvnd' 'wayland')
optdepends=('git: status marks in repositories'
            'poppler: PDF previews'
            'ffmpeg: video frames, audio tags and cover art in previews')
provides=('syn-filemanager')
conflicts=('syn-filemanager' 'syn-dirstat')
replaces=('syn-filemanager' 'syn-dirstat')
makedepends=('cmake' 'pkgconf' 'wayland-protocols')
source=()
sha256sums=()

# No source=() entries (this package builds from the sources sitting
# next to this PKGBUILD, not a downloaded tarball) — makepkg still
# creates $srcdir as a real directory regardless, named "src" next to
# this file. That collides with this project's own src/ directory if
# CMake is ever pointed at $startdir, so every path below is anchored
# on the PKGBUILD's own real location instead, captured once here
# rather than relied on via the deprecated $startdir.
_projdir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

build() {
  cmake -B "$_projdir/build" -S "$_projdir" \
    -DCMAKE_BUILD_TYPE=Release
  cmake --build "$_projdir/build"
}

package() {
  DESTDIR="$pkgdir" cmake --install "$_projdir/build" --prefix /usr
}
