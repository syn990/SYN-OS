#
# labwc parses this file itself — it is NOT sourced as a shell script the
# way Openbox does (see labwc-config(5)). Plain KEY=value only, no export,
# no quotes; either one ends up in the literal, un-parsed environment value.
#
# qt6ct, not qt5ct: every Qt app installed here (falkon, syn-filemanager)
# links against Qt6, which can't load the Qt5-only qt5ct platform-theme
# plugin at all.
#

# To set your language for displaying messages and time/date formats, use the following:
#LANG=en_CA.UTF8

# Keyboard layout: XKB_DEFAULT_LAYOUT (see labwc-config(5)). Set by
# syn-stage1.zsh from synos.conf's KeyMap at install time — see there
# rather than editing this by hand unless you're changing it after install.
XKB_DEFAULT_LAYOUT=gb
QT_QPA_PLATFORMTHEME=qt6ct
