{
  "height": 28,
  "spacing": 6,

  "modules-left": [
    "custom/glyph",
    "wlr/taskbar"
  ],

  "modules-center": [
    "custom/window-title"
  ],

  "modules-right": [
    "custom/recording",
    "custom/synshare",
    "custom/vpn",
    "custom/ssh",
    "custom/relay-status",
    "custom/relay-serving",
    "custom/agent-watching",
    "custom/agent-serving",
    "network",
    "backlight",
    "pulseaudio",
    "custom/cpu",
    "custom/mem",
    "temperature",
    "custom/disk",
    "battery",
    "clock",
    "custom/power"
  ],

  "custom/glyph": {
    "format": "{}",
    "exec": "cat $HOME/.config/waybar/glyph 2>/dev/null || echo ●",
    "signal": 2,
    "tooltip": false,
    "on-click": "/usr/lib/syn-os/syn-bar-launcher.zsh"
  },

  "custom/recording": {
    "format": "{}",
    "exec": "PIDFILE=\"$XDG_RUNTIME_DIR/syn-screen-recorder.pid\"; [ -f \"$PIDFILE\" ] && kill -0 \"$(cat \"$PIDFILE\")\" 2>/dev/null && echo 'Recording' || echo ''",
    "interval": 2,
    "tooltip-format": "Recording \u2014 click to stop",
    "on-click": "/usr/lib/syn-os/screen-recorder.zsh full"
  },

  "custom/synshare": {
    "return-type": "json",
    "format": "{}",
    "interval": 5,
    "exec": "/usr/lib/syn-os/syn-bar-share-status.zsh",
    "on-click": "/usr/lib/syn-os/syn-bar-share-quickmenu.zsh"
  },

  "custom/vpn": {
    "format": "",
    "exec": "/usr/lib/syn-os/syn-bar --vpn",
    "interval": 5
  },

  "custom/ssh": {
    "return-type": "json",
    "format": "{}",
    "max-length": 60,
    "exec": "/usr/lib/syn-os/syn-bar --ssh",
    "interval": 5
  },

  "custom/disk": {
    "interval": 15,
    "return-type": "json",
    "format": " {}",
    "exec": "/usr/lib/syn-os/syn-bar --disk",
    "on-click": "syn-filemanager /"
  },

  "custom/power": {
    "format": "⏻",
    "on-click": "/usr/lib/syn-os/syn-bar-power.zsh"
  },

  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-muted": "",
    "format-icons": {
      "default": ["", "", ""]
    },
    "on-click": "foot -e /usr/lib/syn-os/syn-audio",
    "on-click-middle": "pamixer -t",
    "on-scroll-up": "pamixer -i 5",
    "on-scroll-down": "pamixer -d 5",
    "scroll-step": 5
  },

  "network": {
    "format-wifi": "  {essid}  {bandwidthUpBytes}/{bandwidthDownBytes}",
    "format-ethernet": "󰈀 {ipaddr}  {bandwidthUpBytes}/{bandwidthDownBytes}",
    "format-disconnected": "󰤮",
    "tooltip-format": "{ifname} {ipaddr}/{cidr}",
    "interval": 2,
    "on-click": "foot -e /usr/lib/syn-os/syn-wifi"
  },

  // custom/cpu and custom/mem replace waybar's stock cpu/memory module
  // types — those have no exec hook at all (they always read local
  // /proc internally, no way to redirect them), so making them relay
  // -aware required switching to the custom/* contract, same as
  // custom/disk already was. syn-relay --stat-cpu/--stat-mem handle all
  // three states themselves: real local /proc numbers when the stats
  // client role has never been touched, a dead "--" indicator while
  // active-but-not-yet-connected, and a remote machine's real stats
  // once connected — see syn-relay-src's syn_node_state.h. Persistent
  // "connected: <hostname>" / "no connection to remote host" label —
  // the only always-visible (not hover-tooltip-only) indicator of
  // relay state. Empty text/no bar space used at all when ABSENT
  // (never touched). Also the module whose poll notices a dead remote
  // and reflects that here, in case the remote died without a clean
  // --disconnect. No automatic desktop theme swap on connect/disconnect
  // — removed by request, connecting should not change how this
  // machine looks, only what its bar/menu show.
  "custom/relay-status": {
    "interval": 3,
    "return-type": "json",
    "format": "{}",
    "exec": "/usr/lib/syn-os/syn-relay --stat-relay-status"
  },

  // Server-role counterpart to custom/relay-status above: shows
  // "serving: <ip>" the moment a client connects to this machine's
  // stats server role, "serving (idle)" while running but nobody's
  // attached, nothing at all when the server role isn't running — so
  // being connected-to is as visible as connecting-out is.
  "custom/relay-serving": {
    "interval": 5,
    "return-type": "json",
    "format": "{}",
    "exec": "/usr/lib/syn-os/syn-relay --stat-serving"
  },

  // Screen-watch role counterpart: shows "watching: <ip>" while this
  // machine is actively viewing/controlling a remote node's screen,
  // nothing when it isn't. syn-relay is one binary with several
  // independent roles (see PROTOCOL.md) — this and custom/relay-status
  // above can both show real state simultaneously, since a machine can
  // be a connected stats client and watching a screen at the same time.
  "custom/agent-watching": {
    "interval": 3,
    "return-type": "json",
    "format": "{}",
    "exec": "/usr/lib/syn-os/syn-relay --stat-watching"
  },

  // Screen-host role counterpart: "agent: live" the moment this
  // machine's video+input processes are both up (started via
  // menu.xml's "Let This Machine Be Watched"), nothing when they
  // aren't. Deliberately doesn't distinguish idle-vs-attached like
  // custom/relay-serving does — the screen-host role has no
  // pairing/attach concept yet (see PROTOCOL.md's security posture
  // section), so "running" is the only state there is.
  "custom/agent-serving": {
    "interval": 5,
    "return-type": "json",
    "format": "{}",
    "exec": "/usr/lib/syn-os/syn-relay --stat-agent"
  },

  "custom/cpu": {
    "interval": 2,
    "return-type": "json",
    "format": " {}",
    "exec": "/usr/lib/syn-os/syn-bar --cpu",
    "on-click": "foot -e /usr/lib/syn-os/syn-sysmon --view=cpu"
  },

  "custom/mem": {
    "interval": 5,
    "return-type": "json",
    "format": " {}",
    "exec": "/usr/lib/syn-os/syn-bar --mem",
    "on-click": "foot -e /usr/lib/syn-os/syn-sysmon --view=mem"
  },

  "temperature": {
    "critical-threshold": 80,
    "format": "{temperatureC}°C ",
    "tooltip-format": "{temperatureC}°C ({temperatureF}°F)",
    "interval": 5,
    "on-click": "foot -e /usr/lib/syn-os/syn-sysmon --view=sensors"
  },

  "backlight": {
    "device": "intel_backlight",
    "format": "{percent}% ",
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-"
  },

  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% ",
    "format-plugged": "{capacity}% ",
    "format-icons": ["", "", "", "", ""]
  },

  "clock": {
    "interval": 1,
    "format": "{:%H:%M:%S}",
    "format-alt": "{:%Y-%m-%d %H:%M:%S}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },

  "custom/window-title": {
    "format": "{}",
    "exec": "/usr/lib/syn-os/syn-bar --window-title",
    "max-length": 60,
    "tooltip": false
  },

  // wlr-foreign-toplevel-management has no per-desktop concept, only
  // per-output — so this lists every open window across all 4 LabWC
  // desktops, not just the focused one. all-outputs: false at least
  // scopes it to this monitor.
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 16,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "all-outputs": false
  }
}