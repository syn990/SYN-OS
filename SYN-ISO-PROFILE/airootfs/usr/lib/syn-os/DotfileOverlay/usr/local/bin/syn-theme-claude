#!/usr/bin/env python3
# ------------------------------------------------------------------------------
#                      S Y N - T H E M E - C L A U D E
#
#   The desktop's current SYN-OS palette as a Claude Code theme, so Claude
#   Code in the terminal wears the same theme as everything else.
#
#   Writes ~/.claude/themes/syn-os.json ("SYN-OS" in Claude Code's /theme
#   picker) from ~/.config/syn-os/themes/<current-theme>.theme: a dark or
#   light base, per SYN_THEME_MODE, with the palette laid over it. Claude
#   Code watches that folder, so a running session repaints when the file
#   changes; syn-theme-apply runs this on every switch, which keeps Claude
#   Code on the desktop's theme. Writes only when the text changes.
#
#   --select also sets "theme": "custom:syn-os" in ~/.claude/settings.json,
#   the one-time step that makes Claude Code use it.
#
#   Usage: syn-theme-claude [--select]
#
#   SYN-OS     : The Syntax Operating System
#   Component  : SYN-THEME-CLAUDE (Theming)
#   Author     : William Hayward-Holland (Syntax990)
#   License    : MIT License
# ------------------------------------------------------------------------------
import json
import os
import re
import sys

HOME = os.path.expanduser("~")
SYN = os.path.join(HOME, ".config", "syn-os")
CLAUDE = os.path.join(HOME, ".claude")
OUT = os.path.join(CLAUDE, "themes", "syn-os.json")
SETTINGS = os.path.join(CLAUDE, "settings.json")


def palette(path):
    p = {}
    for line in open(path, encoding="utf-8"):
        m = re.match(r'\s*(SYN_[A-Z_]+)=(["\']?)(.*?)\2\s*$', line)
        if m:
            p[m.group(1)] = m.group(3)
    return p


def rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def hexc(c):
    return "#%02x%02x%02x" % tuple(max(0, min(255, round(v))) for v in c)


def mix(a, b, t):
    """a moved t of the way to b"""
    a, b = rgb(a), rgb(b)
    return hexc(tuple(x + (y - x) * t for x, y in zip(a, b)))


def lum(h):
    def ch(v):
        v /= 255
        return v / 12.92 if v <= 0.03928 else ((v + 0.055) / 1.055) ** 2.4
    r, g, b = rgb(h)
    return 0.2126 * ch(r) + 0.7152 * ch(g) + 0.0722 * ch(b)


def contrast(a, b):
    x, y = sorted((lum(a), lum(b)), reverse=True)
    return (x + 0.05) / (y + 0.05)


def readable(c, bg, toward, want=4.0):
    """c, moved toward `toward` only as far as it takes to read on bg"""
    for i in range(21):
        out = mix(c, toward, i / 20)
        if contrast(out, bg) >= want:
            return out
    return toward


def theme(p):
    bg, alt, panel, hover = p["SYN_BG"], p["SYN_BG_ALT"], p["SYN_PANEL"], p["SYN_PANEL_HOVER"]
    text, border, urgent, accent = p["SYN_TEXT"], p["SYN_BORDER"], p["SYN_URGENT"], p["SYN_ACCENT"]
    light = p.get("SYN_THEME_MODE", "dark") == "light"
    # the palettes carry no green or yellow; these sit with any of them
    ok, warn = ("#1a7f37", "#9a6700") if light else ("#5fd787", "#e5c07b")
    ink = readable(accent, bg, text)             # the accent where it is text
    soft = readable(mix(ink, text, 0.45), bg, text)
    muted = readable(mix(text, bg, 0.45), bg, text, 3.0)
    ok, warn, bad = (readable(c, bg, text) for c in (ok, warn, urgent))
    card = panel if panel.lower() != bg.lower() else hover
    shimmer = lambda c: mix(c, text, 0.35)       # the lighter sweep over animated text
    return {
        "name": "SYN-OS",
        "base": "light" if light else "dark",
        "overrides": {
            # Claude's own colour: logo, spinner, and the accents around it
            "claude": ink, "claudeShimmer": shimmer(ink),
            "clawd_body": ink, "clawd_background": bg,
            "claudeBlue_FOR_SYSTEM_SPINNER": soft, "claudeBlueShimmer_FOR_SYSTEM_SPINNER": shimmer(soft),
            "permission": ink, "permissionShimmer": shimmer(ink),
            "suggestion": ink, "remember": ink, "ide": ink, "professionalBlue": ink,
            "briefLabelClaude": ink, "briefLabelYou": soft,
            # modes and borders
            "autoAccept": soft, "autoAcceptShimmer": shimmer(soft),
            "planMode": soft, "skill": soft, "background": soft, "merged": soft,
            "bashBorder": soft,
            "promptBorder": border, "promptBorderShimmer": shimmer(border),
            "fastMode": warn, "fastModeShimmer": shimmer(warn),
            # text
            "text": text, "inverseText": bg,
            "inactive": muted, "inactiveShimmer": shimmer(muted),
            "subtle": mix(border, bg, 0.35),
            # states
            "success": ok, "error": bad, "warning": warn, "warningShimmer": shimmer(warn),
            # diffs: tinted line backgrounds, the changed words stronger
            "diffAdded": mix(ok, bg, 0.65), "diffRemoved": mix(bad, bg, 0.6),
            "diffAddedDimmed": mix(ok, bg, 0.82), "diffRemovedDimmed": mix(bad, bg, 0.8),
            "diffAddedWord": mix(ok, bg, 0.35), "diffRemovedWord": mix(bad, bg, 0.3),
            # surfaces
            "userMessageBackground": card, "userMessageBackgroundHover": hover,
            "composerSidebarBackground": alt, "bashMessageBackgroundColor": alt,
            "memoryBackgroundColor": alt, "selectionBg": mix(ink, bg, 0.6),
            "rate_limit_fill": ink, "rate_limit_empty": mix(border, bg, 0.4),
        },
    }


def write_if_changed(path, text):
    try:
        if open(path, encoding="utf-8").read() == text:
            return False
    except FileNotFoundError:
        pass
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, path)
    return True


def select():
    try:
        s = json.load(open(SETTINGS, encoding="utf-8"))
    except FileNotFoundError:
        s = {}
    if s.get("theme") == "custom:syn-os":
        return
    s["theme"] = "custom:syn-os"
    write_if_changed(SETTINGS, json.dumps(s, indent=2) + "\n")


def main():
    if not os.path.isdir(CLAUDE):
        return 0                                  # no Claude Code here
    try:
        name = open(os.path.join(SYN, "current-theme"), encoding="utf-8").read().strip()
        p = palette(os.path.join(SYN, "themes", name + ".theme"))
    except OSError as e:
        print(f"syn-theme-claude: no current SYN-OS theme ({e})", file=sys.stderr)
        return 1
    missing = [k for k in ("SYN_BG", "SYN_BG_ALT", "SYN_PANEL", "SYN_PANEL_HOVER", "SYN_TEXT",
                           "SYN_BORDER", "SYN_URGENT", "SYN_ACCENT") if k not in p]
    if missing:
        print(f"syn-theme-claude: {name} lacks {', '.join(missing)}", file=sys.stderr)
        return 1
    write_if_changed(OUT, json.dumps(theme(p), indent=2) + "\n")
    if "--select" in sys.argv[1:]:
        select()
    return 0


if __name__ == "__main__":
    sys.exit(main())
