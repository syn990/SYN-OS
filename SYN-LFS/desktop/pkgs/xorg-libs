noextract=1
build() {
	local e f d
	for e in "${src[@]}"; do
		f=${e%% *}
		f=${f##*/}
		d=${f%.tar.?z*}
		tar -xf "$f"
		pushd "$d" > /dev/null
		case $d in
			libXfont2-[0-9]*) ./configure $XORG_CONFIG --docdir=/usr/share/doc/$d --disable-devel-docs ;;
			libXt-[0-9]*) ./configure $XORG_CONFIG --docdir=/usr/share/doc/$d --with-appdefaultdir=/etc/X11/app-defaults ;;
			libXpm-[0-9]*) ./configure $XORG_CONFIG --docdir=/usr/share/doc/$d --disable-open-zfile ;;
			libpciaccess* | libxkbfile*) meson setup --prefix=/usr --buildtype=release syn-build ;;
			*) ./configure $XORG_CONFIG --docdir=/usr/share/doc/$d ;;
		esac
		if [ -d syn-build ]; then
			ninja -C syn-build install
		else
			make
			make install
		fi
		popd > /dev/null
		rm -rf "$d"
		ldconfig
	done
}
