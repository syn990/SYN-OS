# The audio I/O library Audacity plays and records through, on ALSA
# (which reaches PipeWire via its ALSA plugin). Upstream's autotools
# build, which also installs pa_linux_alsa.h: Audacity's bundled
# PortMixer looks for it to drive ALSA mixer levels
v=19.7.0
src=("https://files.portaudio.com/archives/pa_stable_v190700_20210406.tgz sha256:47efbf42c77c19a05d22e627d42873e991ec0c1357219c0d74ce6a2948cb2def")
build() {
	./configure --prefix=/usr --disable-static --with-alsa --without-jack --without-oss
	make
	make install
}
