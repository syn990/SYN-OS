v=10.5.2
src=("https://github.com/NetworkConfiguration/dhcpcd/releases/download/v$v/dhcpcd-$v.tar.xz md5:b7bc4570c8ffd0cc1c6dbd3a847caeee")
build() {
	./configure --prefix=/usr --sysconfdir=/etc --libexecdir=/usr/lib/dhcpcd \
		--dbdir=/var/lib/dhcpcd --runstatedir=/run --disable-privsep
	make
	make install
	svc dhcpcd
	# dhcpcd configures every interface. The book's static ifconfig.eth0
	# names an interface the kernel renames (enp1s0 and the like), so
	# stage 1 printed a FAIL for it on every boot
	rm -f /etc/sysconfig/ifconfig.*
}
