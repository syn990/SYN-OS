# No systemd user units: syn-pipewire-session.sh starts the daemons from
# labwc's autostart. WirePlumber is its own recipe below
v=1.6.8
src=("https://gitlab.freedesktop.org/pipewire/pipewire/-/archive/$v/pipewire-$v.tar.bz2 md5:9ae75812a76951c93210a26272c90ef3")
build() {
	meson_build -D "session-managers=[]" -D libsystemd=disabled -D logind=disabled \
		-D systemd-user-service=disabled -D examples=disabled -D tests=disabled \
		-D alsa=enabled -D pipewire-alsa=enabled -D udev=enabled \
		-D bluez5=enabled -D gstreamer=disabled -D gstreamer-device-provider=disabled \
		-D libcamera=disabled -D pipewire-jack=disabled -D jack=disabled \
		-D x11=disabled -D x11-xfixes=disabled -D sdl2=disabled -D avahi=disabled \
		-D echo-cancel-webrtc=disabled -D libcanberra=disabled -D roc=disabled \
		-D libffado=disabled -D snap=disabled -D selinux=disabled
}
