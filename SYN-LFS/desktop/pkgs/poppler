# PDF rendering, which GIMP opens PDFs with. No GPGME: its C++ bindings
# (gpgmepp) are only for GPG-signed PDFs; no Boost, which only speeds up
# the Splash renderer
v=26.08.0
src=(
	"https://poppler.freedesktop.org/poppler-$v.tar.xz md5:0c7953c55c449f20d97adbe355bcf49d"
	"https://poppler.freedesktop.org/poppler-data-0.4.12.tar.gz md5:67ee4a40aa830b1f6e2560ce5f6471ba"
)
build() {
	cmake_build -D TESTDATADIR=$PWD/testfiles -D ENABLE_QT5=OFF -D ENABLE_GPGME=OFF -D ENABLE_BOOST=OFF \
		-D ENABLE_UNSTABLE_API_ABI_HEADERS=ON -W no-author
	cd ..
	tar -xf poppler-data-0.4.12.tar.gz
	make -C poppler-data-0.4.12 prefix=/usr install
}
