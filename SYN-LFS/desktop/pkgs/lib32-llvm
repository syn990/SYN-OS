# 32-bit LLVM for 32-bit Mesa's llvmpipe and radeonsi: just libLLVM and
# llvm-config (installed as llvm-config32, which the llvm32 meson cross
# file points Mesa at). Headers come from the 64-bit build of the same
# release. Same source and patch as llvm
v=22.1.8
src=(
	"https://github.com/llvm/llvm-project/releases/download/llvmorg-$v/llvm-project-$v.src.tar.xz md5:69065494ebcb1150b2a329c1b3db7584"
	"https://www.linuxfromscratch.org/patches/blfs/13.1/llvm-$v-upstream_fix-1.patch sha256:4a2084f9714f2f3babc0ed58065c3a6b83cd2828ea19aec1518995a6d2376187"
)
build() {
	patch -Np1 -i ../llvm-$v-upstream_fix-1.patch
	CFLAGS=-m32 CXXFLAGS=-m32 PKG_CONFIG=i686-pc-linux-gnu-pkg-config \
	cmake -S llvm -B llvm/syn-build32 -G Ninja \
		-D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_SKIP_INSTALL_RPATH=ON \
		-D CMAKE_BUILD_TYPE=Release \
		-D LLVM_LIBDIR_SUFFIX=32 \
		-D LLVM_TARGET_ARCH=i686 \
		-D LLVM_HOST_TRIPLE=i686-pc-linux-gnu \
		-D LLVM_DEFAULT_TARGET_TRIPLE=i686-pc-linux-gnu \
		-D LLVM_TARGETS_TO_BUILD="X86;AMDGPU" \
		-D LLVM_BUILD_LLVM_DYLIB=ON \
		-D LLVM_LINK_LLVM_DYLIB=ON \
		-D LLVM_ENABLE_RTTI=ON \
		-D LLVM_ENABLE_FFI=OFF \
		-D LLVM_ENABLE_LIBXML2=OFF \
		-D LLVM_ENABLE_ZLIB=OFF \
		-D LLVM_ENABLE_ZSTD=OFF \
		-D LLVM_INCLUDE_TESTS=OFF \
		-D LLVM_INCLUDE_BENCHMARKS=OFF \
		-D LLVM_INCLUDE_EXAMPLES=OFF \
		-D LLVM_PARALLEL_LINK_JOBS=2 \
		-W no-author
	ninja -C llvm/syn-build32 LLVM llvm-config
	DESTDIR=$PWD/syn-dest32 ninja -C llvm/syn-build32 install-LLVM install-llvm-config
	install_lib32 syn-dest32
	install -m755 syn-dest32/usr/bin/llvm-config /usr/bin/llvm-config32
	install -Dm644 "$SYN_FILES/llvm32.cross" /usr/share/meson/cross/llvm32
}
