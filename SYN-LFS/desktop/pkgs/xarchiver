# Archive manager, in place of Arch's lxqt-archiver: same job in GTK,
# without pulling in half of LXQt to get it
v=0.5.4.27
src=("https://github.com/ib/xarchiver/archive/$v/xarchiver-$v.tar.gz md5:8a6fb3ab5c0161e3fa05ec6a1faf2c12")
build() {
	sed '/TOGGLE.*prefer_unzip/s/TRUE/FALSE/' -i src/pref_dialog.c
	./configure --prefix=/usr --libexecdir=/usr/lib/xfce4         --docdir=/usr/share/doc/xarchiver-$v
	make
	make install
}
