build() {
	tar -xf ../audacity-$v-muse_framework-${au_muse:0:8}.tar.gz -C muse --strip-components=1
	tar -xf ../audacity-$v-muse_deps-${au_muse_deps:0:8}.tar.gz -C muse_deps --strip-components=1
	local f n
	export EXTDEPS_CACHE=$PWD/syn-extdeps
	for f in ../audacity-extdep.*; do
		n=${f#../audacity-extdep.}
		install -Dm644 $f $EXTDEPS_CACHE/downloads/${n%%.*}/${n#*.}
	done
	cmake -B syn-build -G Ninja \
		-D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_INSTALL_LIBDIR=lib \
		-D CMAKE_BUILD_TYPE=Release \
		-D CMAKE_SKIP_INSTALL_RPATH=ON \
		-D EXTDEPS_CACHE=$EXTDEPS_CACHE \
		-D EXTDEPS_OVERRIDE_ALL=SYSTEM \
		-D EXTDEPS_OVERRIDE_PUGIXML=REBUILD \
		-D EXTDEPS_OVERRIDE_UTFCPP=REBUILD \
		-D AU4_BUILD_MODE=release \
		-D AU_BUILD_CLOUD_AUDIOCOM=OFF \
		-D AU_BUILD_USAGEINFO_MODULE=OFF \
		-D MUSE_MODULE_UPDATE=OFF \
		-D MUSE_MODULE_DIAGNOSTICS_CRASHPAD_CLIENT=OFF \
		-D MUSE_ENABLE_UNIT_TESTS=OFF \
		-D MUSE_COMPILE_USE_CCACHE=OFF
	ninja -C syn-build ${=NINJAFLAGS}
	# What the old recipe put down: upstream's AppImage unpacked in /opt
	rm -rf /opt/audacity /usr/bin/audacity /usr/share/applications/audacity.desktop \
		/usr/share/pixmaps/audacity.png
	ninja -C syn-build install
	# The launcher is named "Audacity 4 Portable" upstream, for the AppImage
	sed -i 's/^Name=.*/Name=Audacity/' /usr/share/applications/org.audacityteam.Audacity.desktop
	gtk-update-icon-cache -qtf /usr/share/icons/hicolor || true
	update-mime-database /usr/share/mime || true
	update-desktop-database -q /usr/share/applications || true
	test -x /usr/bin/audacity
}
