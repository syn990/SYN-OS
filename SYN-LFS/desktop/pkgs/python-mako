# Mako templates (the Python module, not the notification daemon), for Mesa
v=1.4.1
src=("https://files.pythonhosted.org/packages/source/M/Mako/mako-$v.tar.gz md5:9c09a897c23a34df7ba614ec2d7229e1")
build() {
	pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD
	pip3 install --no-index --find-links dist --no-user Mako
}
