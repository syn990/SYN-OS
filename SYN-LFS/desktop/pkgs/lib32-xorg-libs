noextract=1
build() {
	local e f d
	for e in "${src[@]}"; do
		f=${e%% *}
		f=${f##*/}
		d=${f%.tar.?z*}
		tar -xf "$f"
		pushd "$d" > /dev/null
		case $d in
			libpciaccess-*) meson_build32 ;;
			libxcb-*) CC32="gcc -m32 -mstackrealign" configure32 --without-doxygen ;;
			libX11-*) configure32 --disable-xf86bigfont --disable-specs ;;
			*) configure32 ;;
		esac
		popd > /dev/null
		rm -rf "$d"
		ldconfig
	done
}
