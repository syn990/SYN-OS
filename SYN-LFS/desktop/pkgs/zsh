# zsh, the login shell SYN-OS's .zshrc and theme scripts are written for
v=5.9.2
src=("https://www.zsh.org/pub/zsh-$v.tar.xz md5:5c8305ba85166838ef062c5e7b245820")
build() {
	sed -e 's|/etc/z|/etc/zsh/z|g' -i Doc/*.*
	./configure --prefix=/usr --sysconfdir=/etc/zsh --enable-etcdir=/etc/zsh \
		--enable-cap --enable-gdbm --enable-pcre --with-tcsetpgrp
	make
	make install
	install -Dm644 "$SYN_FILES/zprofile" /etc/zsh/zprofile
	install -d /etc/profile.d
	for sh in /bin/zsh /usr/bin/zsh; do
		grep -qx "$sh" /etc/shells || echo "$sh" >> /etc/shells
	done
}
