# What hardware is in this machine. B.02.20 is the current release (the
# GitHub tags named T.* are 2003 pre-releases that only sort higher).
# NO_VERSION_CHECK stops lshw looking up the latest version online each run
v=B.02.20
src=("https://ezix.org/software/files/lshw-$v.tar.gz sha256:06d9cf122422220e5dc94e8ea5b01816a69bb6b59368f63d7f21fff31fc6922a")
build() {
	make -C src NO_VERSION_CHECK=1
	make -C src NO_VERSION_CHECK=1 PREFIX=/usr install
}
