# CMake, for the CMake-built packages. Uses the system curl above; its
# bundled copy may not build against the base's OpenSSL 4
v=4.4.2
src=("https://cmake.org/files/v${v%.*}/cmake-$v.tar.gz md5:6911f0379d901db23619413f092b99ef")
build() {
	sed -i '/"lib64"/s/64//' Modules/GNUInstallDirs.cmake
	./bootstrap --prefix=/usr --mandir=/share/man --docdir=/share/doc/cmake-$v --parallel=$(nproc) \
		--system-curl
	make
	make install
}
