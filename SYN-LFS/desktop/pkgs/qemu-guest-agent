# The QEMU guest agent (qemu-ga) on its own, as Arch's qemu-guest-agent:
# it answers the host over a virtio serial port, so virsh can shut the VM
# down cleanly, freeze filesystems for snapshots, run commands and copy
# files. Built from the full QEMU source with everything else switched
# off: no emulators, no qemu-img or other tools, no docs, no optional
# libraries, and only the qemu-ga target, since a plain install would also
# drop QEMU's firmware blobs into /usr/share/qemu. configure sets up its
# own Python venv from the system meson, pip and setuptools plus the wheels
# QEMU ships in python/wheels, with --disable-download keeping it offline.
# sha256 is of the file as downloaded; its sha512 matches Arch's PKGBUILD
v=11.1.1
src=("https://download.qemu.org/qemu-$v.tar.xz sha256:079ffbff8a7111bbc89022107cbabf3bbfd614d5fc9d7cc675991196aca12482")
build() {
	mkdir syn-build
	cd syn-build
	../configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
		--disable-download --without-default-features \
		--disable-system --disable-user --disable-tools --disable-docs \
		--enable-guest-agent
	ninja qga/qemu-ga
	install -m755 qga/qemu-ga /usr/bin/
	# On by default as on Arch; the run script stays down outside a VM
	svc qemu-ga
}
