# Google's own build, unpacked from the .deb (no checksum: it is always
# "current"). Delete the cached .deb and rebuild this to update Chrome
v=stable
src=("https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb -")
noextract=1
build() {
	ar x google-chrome-stable_current_amd64.deb
	tar -xf data.tar.* -C /
	rm -f /etc/cron.daily/google-chrome
	chmod 4755 /opt/google/chrome/chrome-sandbox
	install -m755 "$SYN_FILES/chrome" /usr/bin/chrome
	sed -i 's|^Exec=/usr/bin/google-chrome-stable|Exec=/usr/bin/chrome|' \
		/usr/share/applications/google-chrome.desktop
}
