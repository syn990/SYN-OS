v=3.126.1
src=(
	"https://archive.mozilla.org/pub/security/nss/releases/NSS_${v//./_}_RTM/src/nss-$v.tar.gz md5:0ca322cec564a53ac5a59ce130d96f46"
	"https://www.linuxfromscratch.org/patches/blfs/13.1/nss-standalone-1.patch sha256:87bb1af0b11fd41311b9899187f6e4b3fca9940651123c7bc836ec7497d2da84"
)
build() {
	patch -Np1 -i ../nss-standalone-1.patch
	cd nss
	# NSS's makefiles are not parallel-safe
	make -j1 BUILD_OPT=1 NSPR_INCLUDE_DIR=/usr/include/nspr USE_SYSTEM_ZLIB=1 ZLIB_LIBS=-lz \
		NSS_ENABLE_WERROR=0 NSS_USE_SYSTEM_SQLITE=1 USE_64=1
	cd ../dist
	install -m755 Linux*/lib/*.so /usr/lib
	install -m644 Linux*/lib/*.chk /usr/lib
	install -d /usr/include/nss
	cp -RL {public,private}/nss/* /usr/include/nss
	install -m755 Linux*/bin/{certutil,nss-config,pk12util} /usr/bin
	install -m644 Linux*/lib/pkgconfig/nss.pc /usr/lib/pkgconfig
}
