build() {
	# Kept inside the build tree: the CLI's first-run files and the
	# package cache the restore unpacks into
	export HOME=$PWD/syn-home DOTNET_CLI_HOME=$PWD/syn-home NUGET_PACKAGES=$PWD/syn-nuget
	export DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1 DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
	# The build runs dotnet too, outside a login shell, so not from profile.d:
	# without it .NET finds no libssl.so.3 and aborts
	export DOTNET_OPENSSL_VERSION_OVERRIDE=4
	install -d syn-home syn-feed
	cp ../*.nupkg syn-feed/
	cat > NuGet.Config << EOF2
<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="syn-feed" value="$PWD/syn-feed" />
  </packageSources>
</configuration>
EOF2
	# Passed to every dotnet build in the tree, the Makefile's included.
	# NuGetAudit would look up vulnerability data online
	printf '%s\n' -p:RollForward=Major -p:NuGetAudit=false > Directory.Build.rsp
	# A fresh file stops fetch-geoip.sh downloading; removed after install
	touch IP2LOCATION-LITE-DB1.IPV6.BIN.ZIP
	make TARGETPLATFORM=unix-generic

	rm -rf /usr/lib/openra
	install -d /usr/lib/openra
	cp -P bin/*.dll bin/*.dll.config bin/*.json bin/*.so /usr/lib/openra/
	cp -R bin/runtimes /usr/lib/openra/
	sh -c '. ./packaging/functions.sh; install_data "$1" /usr/lib/openra cnc d2k ra' sh "$PWD"
	rm /usr/lib/openra/IP2LOCATION-LITE-DB1.IPV6.BIN.ZIP
	# openra-ra, openra-cnc, openra-d2k (and -server) run `dotnet OpenRA.dll`
	make TARGETPLATFORM=unix-generic prefix=/usr \
		install-linux-shortcuts install-linux-appdata install-man

	# What the AppImage version of this recipe installed
	rm -rf /opt/openra
	rm -f /usr/bin/openra-{red-alert,tiberian-dawn,dune-2000} \
		/usr/share/applications/openra-{red-alert,tiberian-dawn,dune-2000}.desktop
}
