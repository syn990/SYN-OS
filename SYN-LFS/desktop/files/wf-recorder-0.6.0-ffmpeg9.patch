+/* A codec's supported pixel formats, sample formats and channel layouts:
+ * from FFmpeg 7.1 (libavcodec 61.13.100) avcodec_get_supported_config()
+ * hands them out and the AVCodec fields are gone (removed in 9); before
+ * that the fields are the only source. NULL means every value is fine. */
+#if LIBAVCODEC_VERSION_INT >= AV_VERSION_INT(61, 13, 100)
+template <typename T>
+static const T *codec_supported(const AVCodec *codec, enum AVCodecConfig what)
+{
+    const void *list = nullptr;
+    if (avcodec_get_supported_config(nullptr, codec, what, 0, &list, nullptr) < 0)
+        return nullptr;
+    return static_cast<const T *>(list);
+}
+#define CODEC_SUPPORTED(codec, T, what, field) codec_supported<T>(codec, what)
+#else
+#define CODEC_SUPPORTED(codec, T, what, field) ((codec)->field)
+#endif
+
