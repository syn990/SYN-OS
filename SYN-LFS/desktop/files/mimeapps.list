# What xdg-open (and so Steam, surf and syn-filemanager) opens each
# kind of file and link with, for every user; ~/.config/mimeapps.list
# overrides it
[Default Applications]
x-scheme-handler/http=surf.desktop
x-scheme-handler/https=surf.desktop
text/html=surf.desktop
application/pdf=surf.desktop
image/svg+xml=surf.desktop
image/png=surf.desktop
image/jpeg=surf.desktop
image/gif=surf.desktop
image/webp=surf.desktop
video/mp4=surf.desktop
video/webm=surf.desktop
text/plain=featherpad.desktop
text/markdown=featherpad.desktop
application/x-shellscript=featherpad.desktop
application/json=featherpad.desktop
application/xml=featherpad.desktop
inode/directory=syn-filemanager.desktop
x-scheme-handler/steam=steam.desktop
