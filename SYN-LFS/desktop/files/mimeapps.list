# What xdg-open (and so Steam, surf and syn-shell) opens each
# kind of file and link with, for every user; ~/.config/mimeapps.list
# overrides it, and Preferences > Desktop > Default Apps
# (syn-pipe-defaults.zsh) is how a user changes it
[Default Applications]
x-scheme-handler/http=surf.desktop
x-scheme-handler/https=surf.desktop
text/html=surf.desktop
application/pdf=surf.desktop
image/svg+xml=surf.desktop
image/png=surf.desktop
image/jpeg=surf.desktop
image/gif=surf.desktop
image/webp=surf.desktop
video/mp4=surf.desktop
video/webm=surf.desktop
text/plain=featherpad.desktop
text/markdown=featherpad.desktop
application/x-shellscript=featherpad.desktop
application/json=featherpad.desktop
application/xml=featherpad.desktop
inode/directory=syn-shell.desktop
# Archives open in SYN-SHELL, which reads them itself (libarchive)
application/zip=syn-shell.desktop
application/x-tar=syn-shell.desktop
application/x-compressed-tar=syn-shell.desktop
application/x-bzip2-compressed-tar=syn-shell.desktop
application/x-bzip-compressed-tar=syn-shell.desktop
application/x-xz-compressed-tar=syn-shell.desktop
application/x-zstd-compressed-tar=syn-shell.desktop
application/x-lz4-compressed-tar=syn-shell.desktop
application/x-lzip-compressed-tar=syn-shell.desktop
application/x-lzma-compressed-tar=syn-shell.desktop
application/x-tarz=syn-shell.desktop
application/x-7z-compressed=syn-shell.desktop
application/vnd.rar=syn-shell.desktop
application/x-rar=syn-shell.desktop
application/vnd.efi.iso=syn-shell.desktop
application/x-cd-image=syn-shell.desktop
application/x-iso9660-image=syn-shell.desktop
application/x-cpio=syn-shell.desktop
application/x-archive=syn-shell.desktop
application/vnd.debian.binary-package=syn-shell.desktop
application/x-rpm=syn-shell.desktop
application/vnd.ms-cab-compressed=syn-shell.desktop
application/x-lha=syn-shell.desktop
application/x-xar=syn-shell.desktop
application/java-archive=syn-shell.desktop
application/vnd.android.package-archive=syn-shell.desktop
application/gzip=syn-shell.desktop
application/x-bzip2=syn-shell.desktop
application/x-xz=syn-shell.desktop
application/zstd=syn-shell.desktop
application/x-lz4=syn-shell.desktop
application/x-lzip=syn-shell.desktop
application/x-lzma=syn-shell.desktop
application/x-compress=syn-shell.desktop
x-scheme-handler/steam=steam.desktop
